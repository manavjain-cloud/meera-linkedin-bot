# Copy to .env for local use. Never commit .env. In production these live in Vercel > Settings > Environment Variables.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_SECRET=any_long_random_string
GEMINI_API_KEY=your_gemini_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional: when set, Claude writes the drafts instead of Gemini
ANTHROPIC_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_WRITER_MODEL=gemini-pro-latest
# ANTHROPIC_MODEL=claude-sonnet-4-5
# PASS_SCORE=7
